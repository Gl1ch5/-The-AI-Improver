# Порт и адрес
PORT=3210
HOST=0.0.0.0
# Пароль админки (если не задан — сгенерируется в data/admin-password.txt)
ADMIN_PASSWORD=change-me
# Где хранить config.json и статистику
DATA_DIR=./data

# Необязательно: предзаполнение при самом первом запуске (дальше всё меняется в UI)
UPSTREAM_NAME=OmniRoute
UPSTREAM_BASE_URL=http://127.0.0.1:20128/v1
UPSTREAM_API_KEY=sk-...
CLASSIFIER_MODEL=agy/gemini-3.5-flash-lite
TARGET_MODEL=agy/gemini-3.8-flash-low
MODEL_NAME=gemini-improved
